--==================================================
-- NO CLIP
-- Для собственного проекта Roblox Studio
--==================================================

local function applyNoClip()
    if not character then return end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if noClip then
                if oldCollisions[obj] == nil then
                    oldCollisions[obj] = obj.CanCollide
                end
                obj.CanCollide = false
            elseif oldCollisions[obj] ~= nil then
                obj.CanCollide = oldCollisions[obj]
                oldCollisions[obj] = nil
            end
        end
    end
end

local function setNoClip(enabled)
    noClip = enabled
    clipButton.Text = enabled and "👻 NO CLIP: ON"
        or "👻 NO CLIP: OFF"
    clipButton.BackgroundColor3 = enabled
        and Color3.fromRGB(45, 135, 75) or PURPLE
    applyNoClip()
end

clipButton.Activated:Connect(function()
    setNoClip(not noClip)
end)

