local knob = Instance.new("Frame")
knob.Size = UDim2.fromOffset(48, 48)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Position = UDim2.fromScale(0.5, 0.5)
knob.BackgroundColor3 = ORANGE
knob.Active = false
knob.Parent = joystick
corner(knob, 24)

local activeTouch
local mouseActive = false

local function updateJoystick(pos)
    local center = joystick.AbsolutePosition
        + joystick.AbsoluteSize / 2

    local delta = Vector2.new(pos.X, pos.Y) - center
    local radius = 38

    if delta.Magnitude > radius then
        delta = delta.Unit * radius
    end

    knob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
    flyInput = Vector2.new(
        delta.X / radius,
        -delta.Y / radius
    )
end

local function resetJoystick()
    activeTouch = nil
    mouseActive = false
    flyInput = Vector2.zero
    knob.Position = UDim2.fromScale(0.5, 0.5)
end

joystick.InputBegan:Connect(function(input)
    if not flying then return end

    if input.UserInputType == Enum.UserInputType.Touch then
        activeTouch = input
        updateJoystick(input.Position)
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseActive = true
        updateJoystick(UIS:GetMouseLocation())
    end
end)

UIS.InputChanged:Connect(function(input)
    if not flying then return end

    if mouseActive
        and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateJoystick(UIS:GetMouseLocation())
    elseif activeTouch and input == activeTouch then
        updateJoystick(input.Position)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == activeTouch
        or (mouseActive
            and input.UserInputType == Enum.UserInputType.MouseButton1) then
        resetJoystick()
    end
end)

